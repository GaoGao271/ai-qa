{
  "name": "ai-qa-assistant",
  "version": "1.0.0",
  "description": "原生 Node.js AI 答疑助手（零第三方依赖）",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:env": "node --env-file=.env src/server.js",
    "test": "vitest run",
    "test:api": "vitest run tests/ask.integration.test.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.85"
  }
}
